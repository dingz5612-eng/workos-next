{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OAM-06 Trust Boundary Kernel",
  "type": "object",
  "required": ["kernelId", "status", "scope", "controls", "outcomes"],
  "properties": {
    "kernelId": { "const": "OAM-06" },
    "status": { "enum": ["active"] },
    "scope": { "type": "array", "minItems": 7 },
    "controls": {
      "type": "object",
      "required": ["evidenceTenantScope", "deviceTenantScope", "signedUrlTenantScope", "piiRetention", "sourceWorkbookManifest"]
    },
    "outcomes": {
      "type": "object",
      "required": ["Dormitory", "DormitoryL2", "BusinessProduction", "RepairPartsHR"]
    }
  },
  "additionalProperties": true
}

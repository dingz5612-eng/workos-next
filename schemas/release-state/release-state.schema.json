{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workosnext.local/schemas/release-state/release-state.schema.json",
  "title": "Release State Authority",
  "type": "object",
  "required": [
    "version",
    "generatedAtUtc",
    "generatedBy",
    "currentMain",
    "sources",
    "authoritativeState",
    "prohibitedStates",
    "evidenceRefs",
    "noGoItems"
  ],
  "properties": {
    "version": { "const": "release-state.authority.v1" },
    "generatedAtUtc": { "type": "string" },
    "generatedBy": { "const": "build-current-release-state" },
    "currentMain": {
      "type": "object",
      "required": ["repository", "branch", "headSha", "ci", "v54ControlPlaneGuards"],
      "properties": {
        "repository": { "const": "dingz5612-eng/workos-next" },
        "branch": { "const": "main" },
        "headSha": { "type": "string", "minLength": 40 },
        "ci": { "$ref": "#/$defs/run" },
        "v54ControlPlaneGuards": { "$ref": "#/$defs/run" }
      },
      "additionalProperties": true
    },
    "sources": { "type": "object" },
    "authoritativeState": {
      "type": "object",
      "required": [
        "dormInt",
        "rtFinal",
        "evidenceGraph",
        "completionDashboard",
        "businessLineRegistry",
        "finalSystemGate",
        "bStageGate",
        "observation",
        "dormitory",
        "dormitoryL2",
        "businessProduction",
        "repair",
        "parts",
        "hr"
      ],
      "properties": {
        "dormInt": { "const": "DORM_INT_PASSED" },
        "rtFinal": { "type": "string" },
        "evidenceGraph": { "const": "L1_INTERNAL_PILOT_OBSERVATION" },
        "completionDashboard": { "const": "L1_INTERNAL_PILOT_OBSERVATION" },
        "businessLineRegistry": { "const": "ALIGNED" },
        "finalSystemGate": { "const": "blocked" },
        "bStageGate": { "const": "passed" },
        "observation": { "const": "L1_INTERNAL_PILOT_OBSERVATION" },
        "dormitory": { "const": "L1_INTERNAL_PILOT_OBSERVATION" },
        "dormitoryL2": { "const": "BLOCKED" },
        "businessProduction": { "const": "BLOCKED" },
        "repair": { "const": "L0 Contract Preview" },
        "parts": { "const": "L0 Contract Preview" },
        "hr": { "const": "L0 Contract Preview" }
      },
      "additionalProperties": true
    },
    "prohibitedStates": {
      "type": "object",
      "required": [
        "dormitoryL2ProductionAllowed",
        "businessProductionAllowed",
        "repairPartsHrProductionAllowed"
      ],
      "properties": {
        "dormitoryL2ProductionAllowed": { "const": false },
        "businessProductionAllowed": { "const": false },
        "repairPartsHrProductionAllowed": { "const": false }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "not": { "pattern": "^\\.tmp|[\\\\/]\\.tmp[\\\\/]" } }
    },
    "noGoItems": { "type": "array" }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["name", "status", "conclusion", "headSha"],
      "properties": {
        "name": { "type": "string" },
        "status": { "const": "completed" },
        "conclusion": { "const": "success" },
        "headSha": { "type": "string", "minLength": 40 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

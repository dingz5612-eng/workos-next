{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workosnext.authority.master-design.schema.v1",
  "title": "WorkOSNext Current OAM Master Design",
  "type": "object",
  "required": [
    "version",
    "status",
    "architecture",
    "designId",
    "authorityRefs",
    "currentArchitectureUniqueEffective",
    "fourGraphViewPolicy",
    "threeLayerPartitionPolicy",
    "sixLoopExecutionOrder",
    "notGoSignals",
    "secondAuthorityForbiddenSources",
    "canonicalConfirmOrder",
    "blockedMutationClasses",
    "releaseLocks"
  ],
  "properties": {
    "version": { "const": "workosnext.authority.master-design.v1" },
    "status": { "const": "authoritative-current-no-go" },
    "architecture": { "const": "oam.current" },
    "designId": { "type": "string" },
    "authorityRefs": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "currentArchitectureUniqueEffective": { "type": "object" },
    "fourGraphViewPolicy": { "type": "array", "minItems": 4 },
    "threeLayerPartitionPolicy": { "type": "array", "minItems": 3 },
    "sixLoopExecutionOrder": { "type": "array", "minItems": 6 },
    "notGoSignals": { "type": "array", "minItems": 4 },
    "secondAuthorityForbiddenSources": { "type": "array", "minItems": 6 },
    "canonicalConfirmOrder": { "type": "array", "minItems": 9 },
    "blockedMutationClasses": { "type": "array", "minItems": 10 },
    "releaseLocks": { "type": "object" }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workosnext.local/schemas/surface/surface-experience-contract.schema.json",
  "title": "Surface Experience Contract",
  "type": "object",
  "required": ["contractId", "status", "statusBoundary", "requiredContracts", "machineChecks", "forbidden"],
  "properties": {
    "contractId": { "type": "string" },
    "status": { "type": "string" },
    "statusBoundary": { "type": "object" },
    "requiredContracts": { "type": "array", "items": { "type": "string" }, "minItems": 10 },
    "machineChecks": { "type": "array", "items": { "type": "string" }, "minItems": 10 },
    "forbidden": { "type": "array", "items": { "type": "string" }, "minItems": 5 }
  }
}

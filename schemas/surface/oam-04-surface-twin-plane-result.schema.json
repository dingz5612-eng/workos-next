{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workosnext.local/schemas/surface/oam-04-surface-twin-plane-result.schema.json",
  "title": "OAM-04 Surface Twin-Plane Result",
  "type": "object",
  "required": ["taskId", "status", "checks", "contracts", "schemas", "artifacts", "tests", "statusBoundary"],
  "properties": {
    "taskId": { "const": "OAM-04" },
    "status": { "enum": ["passed", "blocked"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "script", "status"],
        "properties": {
          "name": { "type": "string" },
          "script": { "type": "string" },
          "artifact": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "minItems": 14
    },
    "contracts": { "type": "array", "items": { "type": "string" }, "minItems": 13 },
    "schemas": { "type": "array", "items": { "type": "string" }, "minItems": 13 },
    "artifacts": { "type": "array", "items": { "type": "string" }, "minItems": 8 },
    "tests": { "type": "array", "items": { "type": "string" }, "minItems": 8 },
    "statusBoundary": {
      "type": "object",
      "required": ["dormitoryL2ProductionAllowed", "businessProductionGo", "repairPartsHrProductionAllowed"],
      "properties": {
        "dormitoryL2ProductionAllowed": { "const": false },
        "businessProductionGo": { "const": false },
        "repairPartsHrProductionAllowed": { "const": false }
      }
    }
  }
}

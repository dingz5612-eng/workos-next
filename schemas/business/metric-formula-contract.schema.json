{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workosnext.local/schemas/business/metric-formula-contract.schema.json",
  "type": "object",
  "required": ["version", "domain", "productionAllowed", "metrics", "semanticFailureCases"],
  "properties": {
    "version": { "type": "string" },
    "domain": { "const": "dormitory" },
    "productionAllowed": { "const": false },
    "metrics": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["metricId", "中文名称", "formula", "unit", "window", "dimension", "target", "yellowThreshold", "redThreshold", "minSampleSize", "owner", "drillDown"],
        "properties": {
          "metricId": { "type": "string" },
          "formula": { "type": "string" },
          "unit": { "type": "string" },
          "window": { "type": "string" },
          "dimension": { "type": "array", "minItems": 1 },
          "owner": { "type": "string" },
          "drillDown": { "type": "array", "minItems": 1 }
        }
      }
    },
    "semanticFailureCases": { "type": "array", "minItems": 2 }
  }
}

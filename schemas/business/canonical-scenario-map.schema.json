{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workosnext.local/schemas/business/canonical-scenario-map.schema.json",
  "type": "object",
  "required": ["version", "domain", "productionAllowed", "mappings", "uniqueness"],
  "properties": {
    "version": { "type": "string" },
    "domain": { "const": "dormitory" },
    "productionAllowed": { "const": false },
    "mappings": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioId", "definitionId", "workItemType", "workItemId", "ownerDomain", "surfaceId", "commandType", "sourceScenario", "migrationRefs"],
        "properties": {
          "scenarioId": { "type": "string" },
          "definitionId": { "type": "string", "pattern": "^definition\\." },
          "workItemType": { "type": "string" },
          "workItemId": { "type": "string", "pattern": "^wi\\." },
          "ownerDomain": { "type": "string" },
          "surfaceId": { "type": "string" },
          "commandType": { "type": "string" },
          "sourceScenario": { "type": "string" },
          "migrationRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "value", "readOnly", "executable", "affectsAdmission", "affectsRuntimeConfirm", "affectsBusinessIdentity", "affectsLedger", "deletionProofRef"],
              "properties": {
                "type": { "const": "sourceCardId" },
                "value": { "type": "string" },
                "readOnly": { "const": true },
                "executable": { "const": false },
                "affectsAdmission": { "const": false },
                "affectsRuntimeConfirm": { "const": false },
                "affectsBusinessIdentity": { "const": false },
                "affectsLedger": { "const": false },
                "deletionProofRef": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "uniqueness": { "type": "object" }
  }
}

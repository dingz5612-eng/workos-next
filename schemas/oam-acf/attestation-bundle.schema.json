{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workosnext.local/schemas/oam-acf/attestation-bundle.schema.json",
  "title": "OAM-ACF Phase 0 Attestation Bundle",
  "type": "object",
  "required": [
    "version",
    "generatedAtUtc",
    "generatedBy",
    "repository",
    "branch",
    "actualHeadSha",
    "currentStateHeadSha",
    "pr78MergeSha",
    "pr79MergeSha",
    "subjectCommit",
    "evidenceCommit",
    "attestationCommit",
    "artifactGitBindingCommit",
    "releaseStates",
    "noGoItems",
    "evidenceRefs"
  ],
  "properties": {
    "version": { "const": "oam-acf.attestation-bundle.v1" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "generatedBy": { "const": "build-oam-acf-baseline" },
    "repository": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "actualHeadSha": { "$ref": "#/$defs/sha" },
    "currentStateHeadSha": { "$ref": "#/$defs/sha" },
    "pr78MergeSha": { "$ref": "#/$defs/sha" },
    "pr79MergeSha": { "$ref": "#/$defs/sha" },
    "subjectCommit": { "$ref": "#/$defs/sha" },
    "evidenceCommit": { "$ref": "#/$defs/sha" },
    "attestationCommit": { "$ref": "#/$defs/sha" },
    "artifactGitBindingCommit": { "$ref": "#/$defs/sha" },
    "ci": { "$ref": "#/$defs/workflowRun" },
    "v54ControlPlaneGuards": { "$ref": "#/$defs/workflowRun" },
    "releaseStates": {
      "type": "object",
      "required": ["dormitory", "dormitoryL2", "businessProduction", "repair", "parts", "hr"],
      "properties": {
        "dormitory": { "type": "string", "minLength": 1 },
        "dormitoryL2": { "type": "string", "minLength": 1 },
        "businessProduction": { "type": "string", "minLength": 1 },
        "repair": { "type": "string", "minLength": 1 },
        "parts": { "type": "string", "minLength": 1 },
        "hr": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "noGoItems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflowRun": {
      "type": "object",
      "required": ["id", "name", "status", "conclusion", "headSha"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "conclusion": { "type": "string" },
        "headSha": { "$ref": "#/$defs/sha" },
        "htmlUrl": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}

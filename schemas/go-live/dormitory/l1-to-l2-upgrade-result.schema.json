{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dormitory L1 to L2 Upgrade Result",
  "type": "object",
  "required": [
    "status",
    "eligible",
    "productionAllowed",
    "l2ProductionAllowed",
    "businessProductionAllowed",
    "decision",
    "criteria"
  ],
  "properties": {
    "status": { "enum": ["NOT_ELIGIBLE", "REQUIRES_SEPARATE_STAGE"] },
    "eligible": { "const": false },
    "productionAllowed": { "const": false },
    "l2ProductionAllowed": { "const": false },
    "businessProductionAllowed": { "const": false },
    "decision": { "enum": ["continue_l1_observation", "requires_next_stage_gate"] }
  }
}

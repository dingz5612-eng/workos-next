{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dormitory L1 Observation Window",
  "type": "object",
  "required": [
    "observationId",
    "businessLine",
    "status",
    "productionAllowed",
    "l2ProductionAllowed",
    "durationDays",
    "minimumCleanDaysForUpgrade",
    "stopConditions",
    "holdConditions",
    "dailyDecisionRules",
    "scopeBoundaries"
  ],
  "properties": {
    "observationId": { "type": "string", "minLength": 1 },
    "businessLine": { "const": "Dormitory" },
    "status": { "const": "L1 Internal Pilot Observation Window" },
    "productionAllowed": { "const": false },
    "l2ProductionAllowed": { "const": false },
    "businessProductionAllowed": { "const": false },
    "durationDays": { "const": 7 },
    "minimumCleanDaysForUpgrade": { "const": 7 },
    "stopConditions": { "type": "array", "minItems": 14, "items": { "type": "string" } },
    "holdConditions": { "type": "array", "minItems": 9, "items": { "type": "string" } }
  }
}

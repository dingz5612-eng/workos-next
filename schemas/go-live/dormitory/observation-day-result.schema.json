{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dormitory L1 Daily Observation Result",
  "type": "object",
  "required": [
    "day",
    "status",
    "decision",
    "productionAllowed",
    "l2ProductionAllowed",
    "p0StopCount",
    "p1HoldCount",
    "financeDailyClose",
    "evidenceMetrics",
    "projectionLag",
    "slaMetrics",
    "rates",
    "gateStatus",
    "rollbackReadiness",
    "training",
    "support"
  ],
  "properties": {
    "day": { "type": "integer", "minimum": 1, "maximum": 7 },
    "status": { "enum": ["passed", "hold", "paused", "rollback_required"] },
    "decision": { "enum": ["continue_l1_observation", "hold_and_fix", "pause_or_rollback"] },
    "productionAllowed": { "const": false },
    "l2ProductionAllowed": { "const": false },
    "p0StopCount": { "type": "integer", "minimum": 0 },
    "p1HoldCount": { "type": "integer", "minimum": 0 }
  }
}

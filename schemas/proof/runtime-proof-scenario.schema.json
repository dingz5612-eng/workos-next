{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workosnext.local/schemas/proof/runtime-proof-scenario.schema.json",
  "title": "RuntimeProofScenario",
  "type": "object",
  "required": [
    "scenarioId",
    "scenarioType",
    "workItemType",
    "requiredProofs",
    "expectedTrace"
  ],
  "properties": {
    "scenarioId": { "type": "string", "minLength": 1 },
    "scenarioType": {
      "type": "string",
      "enum": [
        "committed_scenario",
        "rejected_command_scenario",
        "idempotency_conflict_scenario",
        "rejected_then_committed_scenario",
        "rollback_compensation_scenario"
      ]
    },
    "workItemType": { "type": "string", "minLength": 1 },
    "requiredProofs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "expectedTrace": {
      "type": "object",
      "required": ["case", "workItem", "submission"],
      "properties": {
        "case": { "const": true },
        "workItem": { "const": true },
        "submission": { "const": true },
        "domainEvent": { "type": "boolean" },
        "ledgerTransaction": { "type": "boolean" },
        "rejectionTrace": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

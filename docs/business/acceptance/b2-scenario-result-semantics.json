{
  "version": "rtb.b2-scenario-result-semantics.v1",
  "scenarioTypes": {
    "committed_scenario": {
      "required": ["CommandSubmission", "DomainEvent", "FactTrace"],
      "moneyRequired": ["LedgerTransaction"],
      "forbidden": ["RejectedCommandSubmission", "RejectionTrace"]
    },
    "rejected_command_scenario": {
      "required": ["RejectedCommandSubmission", "RejectionTrace", "AuditOrInvariantEvidence"],
      "forbidden": ["DomainEvent", "LedgerTransaction"],
      "statusCodes": [403, 409, 422]
    },
    "gate_only_blocked_scenario": {
      "required": ["GateResult", "InvariantCheckOrShadowCompareReport", "RollbackOrCompensationBlocker"],
      "forbidden": ["BusinessDomainEvent", "LedgerTransaction"],
      "commandSubmissionRequired": false
    }
  },
  "productionAllowed": false,
  "nextGate": "RT-B B-Stage Gate Closure"
}

  "failureSemantics": [
    {
      "failureCode": "missing_required_business_profile",
      "messageZh": "缺少渠道/企业名称、联系人或联系方式，不能提交档案。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "missing_key_evidence",
      "messageZh": "缺少营业执照、合作协议、授权证明或合同证据，不能启用渠道或协议。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "invalid_agreement_date_range",
      "messageZh": "协议开始日期和结束日期不合法，不能提交协议。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "agreement_approval_required",
      "messageZh": "协议尚未审核，不能生效或作为可用资格。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "expired_agreement_forbidden",
      "messageZh": "协议已过期，不能作为可用资格或渠道发布依据。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "inactive_product_price_forbidden",
      "messageZh": "未生效商品或价格版本不能绑定为可用资格。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "missing_effective_price",
      "messageZh": "缺少有效价格版本，不能启用渠道发布规则。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "operation_blocked_publication_forbidden",
      "messageZh": "房源存在运营阻断、维修或停售，不能发布为可用。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "direct_rateplan_truth_write_forbidden",
      "messageZh": "渠道与企业客户不能直接写价格金额真值，必须引用场景包 3 的商品/价格版本。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "direct_quote_reservation_forbidden",
      "messageZh": "渠道或企业协议不能直接生成报价或预订，必须交给场景包 4 或场景包 5 校验。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "direct_inventory_hold_forbidden",
      "messageZh": "渠道发布规则不能直接锁库存，外部渠道回传预订必须进入场景包 5 校验。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "direct_finance_ledger_forbidden",
      "messageZh": "佣金和结算规则意向不能直接写账务，必须交给 finance-gate 或财务规则权威。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "forged_internal_reference",
      "messageZh": "系统引用由系统绑定，用户不能填写内部编号。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "readonly_result_write_attempt",
      "messageZh": "搜索、列表、看板和报表只读，不能直接写渠道、协议或发布事实。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "duplicate_channel_submission",
      "messageZh": "该渠道或协议提交已处理，请查看结果。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "concurrent_channel_conflict",
      "messageZh": "同一渠道、企业客户、协议或发布规则正在被其他人更新，请刷新后重试。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "unauthorized_channel_action",
      "messageZh": "当前角色不能执行该渠道、协议、发布或财务规则意向动作。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "confirmed_agreement_inline_edit_forbidden",
      "messageZh": "已启用渠道、已生效协议或已发布规则不能原地编辑，只能新版本、续签、暂停、停用、补证或纠错。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "commission_settlement_evidence_required",
      "messageZh": "提交佣金与结算规则意向时必须绑定佣金依据、结算说明或合同证据。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "channel_publish_requires_valid_eligibility",
      "messageZh": "渠道发布必须先有有效协议、有效商品/价格资格和发布检查结果。",
      "sideEffectsAllowed": false
    }
  ],
  "invariants": [
    "企业客户必须有主体名称、联系人、联系方式、协议有效期和证据。",
    "渠道必须有渠道名称、渠道类型、联系人、对接方式、启停状态和证据。",
    "协议价资格只能引用场景包 3 的商品/价格版本或价格策略，不得在本包直接手填最终价格真值。",
    "渠道发布只能引用已生效商品和价格，并且必须受场景包 2 的运营状态阻断。",
    "佣金、账期、结算方式只能形成规则意向或 finance-gate 输入，不得直接写账务。",
    "渠道启用不等于商品可报价；协议生效不等于价格已生效；渠道发布不等于库存已锁定。",
    "已生效协议不得原地覆盖；只能新版本、续签、停用、作废或纠错。",
    "查询、搜索、列表、看板、报表永远只读，不得写业务事实。",
    "失败路径不得启用渠道、不得发布商品、不得生成报价或预订，不得写非法 RatePlan、Quote、Reservation、InventoryHold、Payment、Refund、Ledger，不得刷新错误 Projection/Search/Dashboard。"
  ],

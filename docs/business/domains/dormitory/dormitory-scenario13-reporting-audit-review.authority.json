      "LedgerTransaction",
      "已修复原事实",
      "已入账",
      "已上线",
      "final GO"
    ],
    "downstreamRecheckRuleZh": "场景包 13 只输出报表快照、指标快照、财务核对视图、审计发现、复盘结论、行动计划、问题追踪、导出记录、证据摘要和只读对象引用；所有行动计划只能跳转回对应场景包或 finance-gate 处理。"
  },
  "businessBoundaries": {
    "responsibilityZh": "本场景包只负责经营报表、财务核对视图、审计发现、周期复盘、行动计划、问题追踪、导出记录和证据审阅。",
    "notResponsibleZh": [
      "房源建档",
      "运营状态确认",
      "定价",
      "报价",
      "预订确认",
      "入住办理",
      "收款",
      "押金",
      "退款",
      "退房",
      "房务执行",
      "渠道协议维护",
      "账务事实"
    ],
    "allowedWritesZh": [
      "ReportSnapshot",
      "MetricSnapshot",
      "AuditFinding",
      "ReviewConclusion",
      "ActionPlan",
      "IssueTrackingItem",
      "EvidenceReviewRecord",
      "StatusTimeline",
      "ReportExportRecord",
      "ReportStatusTimeline"
    ],
    "forbiddenWritesZh": [
      "Room",
      "Bed",
      "OperationStatus",
      "RatePlan",
      "Quote",
      "Reservation",
      "Stay",
      "Payment",
      "Deposit",
      "Refund",
      "LedgerEntry",
      "LedgerTransaction"
    ],
    "semanticGuardsZh": [
      "报表、看板、搜索、导出均只读，不得写业务事实。",
      "审计发现只能生成问题和行动计划，不能直接修正原事实。",
      "行动计划只能跳转回对应场景包或 finance-gate。",
      "财务指标只能读取 finance-gate 确认事实。",
      "发布报表锁定快照；后续更正必须生成新版本。"
    ]
  },
  "objects": [
    { "objectName": "ReportPeriod", "businessNameZh": "报表周期", "descriptionZh": "报表锁定的开始时间、结束时间和周期标签。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyPeriod" },
    { "objectName": "ReportScope", "businessNameZh": "报表范围", "descriptionZh": "楼栋、渠道、企业客户、商品、房间/床位和报表类型范围。", "ownedByScenarioPackageNo": 13, "writeDisposition": "versionedScope" },
    { "objectName": "MetricDefinition", "businessNameZh": "指标定义", "descriptionZh": "指标口径来源、公式、数据来源、时间范围、权限、血缘和刷新要求。", "ownedByScenarioPackageNo": 13, "writeDisposition": "definitionSnapshot" },
    { "objectName": "MetricSnapshot", "businessNameZh": "指标快照", "descriptionZh": "按照锁定口径和数据版本生成的指标值、趋势、分组和异常点。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlySnapshot" },
    { "objectName": "ReportSnapshot", "businessNameZh": "报表快照", "descriptionZh": "锁定范围、时间、数据版本、计算口径和报表内容。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlySnapshot" },
    { "objectName": "AuditFinding", "businessNameZh": "审计发现", "descriptionZh": "异常指标、缺证据、流程断点、状态冲突、重复/并发异常或未闭环任务。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyFinding" },
    { "objectName": "EvidenceReviewRecord", "businessNameZh": "证据审阅记录", "descriptionZh": "针对报表数据、指标和审计发现的证据完整性审阅记录。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyEvidenceReview" },
    { "objectName": "ReviewMeetingRecord", "businessNameZh": "复盘会议记录", "descriptionZh": "周期复盘的会议纪要、参与人、结论和跟进事项。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyReviewRecord" },
    { "objectName": "ReviewConclusion", "businessNameZh": "复盘结论", "descriptionZh": "复盘结论、行动目标和改进方向。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyConclusion" },
    { "objectName": "ActionPlan", "businessNameZh": "行动计划", "descriptionZh": "改进措施、负责人、期限、优先级和关联场景包跳转。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyPlan" },
    { "objectName": "IssueTrackingItem", "businessNameZh": "问题追踪项", "descriptionZh": "行动计划或审计发现的处理状态、责任人和关闭记录。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyIssue" },
    { "objectName": "ReportExportRecord", "businessNameZh": "报表导出记录", "descriptionZh": "导出人、导出范围、导出时间、报表版本和审计轨迹。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyExport" },
    { "objectName": "ReportStatusTimeline", "businessNameZh": "报表状态历史", "descriptionZh": "报表草稿、数据待确认、已生成、已发布、已归档等状态变更。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyTimeline" },
    { "objectName": "StatusTimeline", "businessNameZh": "状态历史", "descriptionZh": "记录报表、审计发现、复盘和行动计划的状态历史。", "ownedByScenarioPackageNo": 13, "writeDisposition": "appendOnlyTimeline" }
  ],
  "reportingStatusOptions": [
    "报表草稿",
    "数据待确认",
    "数据不可用于正式报表",
    "报表已生成",
    "报表已发布",
    "报表已归档",
    "审计发现待确认",
    "行动计划待处理",
    "问题已关闭"
  ],
  "metricCatalog": [
    { "metricKey": "resource_count", "nameZh": "房源数量", "sourcePackages": [1], "financeGateOnly": false },
    { "metricKey": "operable_resource_count", "nameZh": "可运营房源", "sourcePackages": [2], "financeGateOnly": false },
    { "metricKey": "quotable_product_count", "nameZh": "可报价商品", "sourcePackages": [3], "financeGateOnly": false },
    { "metricKey": "quote_conversion", "nameZh": "报价转化", "sourcePackages": [4, 5], "financeGateOnly": false },
    { "metricKey": "reservation_count", "nameZh": "预订数", "sourcePackages": [5], "financeGateOnly": false },
    { "metricKey": "checkin_count", "nameZh": "入住数", "sourcePackages": [7], "financeGateOnly": false },
    { "metricKey": "in_stay_count", "nameZh": "在住数", "sourcePackages": [8], "financeGateOnly": false },
    { "metricKey": "checkout_count", "nameZh": "退房数", "sourcePackages": [9], "financeGateOnly": false },
    { "metricKey": "cancel_no_show_count", "nameZh": "取消/未到店数", "sourcePackages": [10], "financeGateOnly": false },
    { "metricKey": "recognized_revenue", "nameZh": "收入确认", "sourcePackages": [6, 9, 10], "financeGateOnly": true },
    { "metricKey": "deposit_balance", "nameZh": "押金余额", "sourcePackages": [6, 9, 10], "financeGateOnly": true },
    { "metricKey": "refund_request_count", "nameZh": "退款申请", "sourcePackages": [9, 10], "financeGateOnly": true },
    { "metricKey": "housekeeping_maintenance_tasks", "nameZh": "维修房务任务", "sourcePackages": [11], "financeGateOnly": false },
    { "metricKey": "channel_corporate_contribution", "nameZh": "渠道/企业客户贡献", "sourcePackages": [12, 4, 5], "financeGateOnly": false },
    { "metricKey": "exception_closure_rate", "nameZh": "异常闭环率", "sourcePackages": [8, 10, 11, 13], "financeGateOnly": false }
  ],
  "metricDefinitionRule": {
    "mustHaveFormula": true,
    "mustHaveSourcePackages": true,
    "mustHaveTimeRange": true,
    "mustHavePermissionEnvelope": true,
    "mustHaveLineageEnvelope": true,
    "mustHaveFreshnessEnvelope": true,
    "mustHaveCalculationVersion": true,
    "financialMetricsReadFinanceGateOnly": true
  },
  "steps": [
    {
      "stepNo": 1,
      "stepId": "select-report-scope",
      "nameZh": "选择报表范围",
      "commandId": "Dorm.ReportScopeSelect",
      "entryFromZh": ["经营报表首页", "今日任务", "工作项", "我的草稿"],
      "userFilledFields": ["报表名称", "备注"],
      "userSelectedFields": ["时间范围", "楼栋/区域", "渠道", "企业客户", "商品", "房间/床位范围", "报表类型"],
      "systemGeneratedFields": ["reportScopeRef", "periodStart", "periodEnd", "scopeVersion", "createdBy"],
      "validations": ["时间范围不能为空", "用户不得填写 reportId、objectId、digest、projectionVersion"],
      "outputs": ["报表范围草稿", "报表周期"]
    },
    {
      "stepNo": 2,
      "stepId": "data-completeness-check",
      "nameZh": "数据完整性检查",
      "commandId": "Dorm.ReportDataQualityCheck",
      "userSees": ["数据来源", "刷新时间", "缺失项", "权限状态", "血缘状态"],
      "systemCalculatedFields": ["permissionEnvelope", "lineageEnvelope", "freshnessEnvelope", "evidenceCompleteness"],
      "systemGeneratedFields": ["dataQualityCheckRef", "freshnessStatus", "lineageStatus", "permissionStatus"],
      "validations": ["数据不完整时不得生成正式报表", "缺权限、缺血缘或数据过期只能生成草稿或问题清单"],
      "outputs": ["数据完整性检查结果", "缺失项清单"]
    },
    {
      "stepNo": 3,
      "stepId": "generate-business-report-snapshot",
      "nameZh": "生成经营报表快照",
      "commandId": "Dorm.BusinessReportSnapshotGenerate",
      "userSelectedFields": ["经营总览", "房源利用", "预订转化", "入住在住", "退房周转", "渠道企业", "房务维修", "异常治理"],
      "systemCalculatedFields": ["指标值", "同比/环比", "趋势", "分组", "异常点"],
      "systemGeneratedFields": ["reportSnapshotRef", "metricSnapshotRefs", "calculationVersion", "generatedAt"],
      "validations": ["指标必须来自已确认事实或授权投影", "不得从 UI 页面状态计算指标"],
      "outputs": ["报表快照", "指标快照"]
    },
    {
      "stepNo": 4,
      "stepId": "generate-finance-review-view",
      "nameZh": "生成财务核对视图",
      "commandId": "Dorm.FinanceReviewSnapshotGenerate",
      "userSees": ["已确认收款", "押金余额", "退款申请", "扣费申请", "支出意向", "finance-gate 确认状态"],
      "systemReadonlyInputs": ["finance-gate 已确认账务事实", "收款/押金/退款/扣费处理状态"],
      "systemGeneratedFields": ["financeReviewSnapshotRef", "financeSourceVersion"],
      "validations": ["非 finance-gate 数据不得作为财务真值"],
      "outputs": ["财务核对视图"]
    },
    {
      "stepNo": 5,
      "stepId": "audit-finding-and-location",
      "nameZh": "审计发现与问题定位",
      "commandId": "Dorm.AuditFindingCreate",
      "userSees": ["异常指标", "缺证据", "流程断点", "状态冲突", "重复/并发异常", "未闭环任务"],
      "userFilledFields": ["审计说明", "风险等级", "建议处理人", "处理期限"],
      "userSelectedFields": ["问题类型", "责任场景包", "是否生成行动计划"],
      "systemGeneratedFields": ["auditFindingRef", "findingSeverity", "sourceScenarioRef", "drilldownRefs"],
      "validations": ["审计发现只能引用原事实，不得覆盖原事实"],
      "outputs": ["审计发现", "问题定位"]
    },
    {
      "stepNo": 6,
      "stepId": "review-conclusion-action-plan",
      "nameZh": "复盘结论与行动计划",
      "commandId": "Dorm.ReviewConclusionActionPlanCreate",
      "secondaryCommandIds": ["Dorm.ActionPlanCreate", "Dorm.IssueTrackingItemCreate"],
      "userFilledFields": ["复盘结论", "行动目标", "改进措施", "负责人", "完成期限"],
      "userSelectedFields": ["行动计划类型", "关联场景包", "优先级"],
      "systemGeneratedFields": ["reviewConclusionRef", "actionPlanRef", "issueTrackingItemRef"],
      "validations": ["行动计划只能生成后续任务或跳转到对应场景包处理", "不得直接修改业务数据"],
      "outputs": ["复盘结论", "行动计划", "问题追踪项"]
    },
    {
      "stepNo": 7,
      "stepId": "publish-export-timeline",
      "nameZh": "发布、导出与历史",
      "commandId": "Dorm.ReportPublish",
      "secondaryCommandIds": ["Dorm.ReportExportRecordCreate", "Dorm.ReportArchive"],
      "userSelectedFields": ["保存草稿", "提交复盘", "发布内部报表", "导出", "归档"],
      "systemGeneratedFields": ["reportVersion", "publishedAt", "exportRecordRef", "auditTrailRef"],
      "validations": ["发布报表锁定快照", "后续更正必须生成新版本，不得覆盖已发布报表"],
      "outputs": ["发布报表", "导出记录", "版本历史"]
    }
  ],

      }
    ],
    "handoffOutputs": [
      "报表快照",
      "指标快照",
      "财务核对视图",
      "审计发现",
      "复盘结论",
      "行动计划",
      "问题追踪",
      "导出记录",
      "证据摘要",
      "只读对象引用"
    ],
    "forbiddenOutputsZh": [

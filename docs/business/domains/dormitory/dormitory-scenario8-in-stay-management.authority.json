      "sideEffectsAllowed": false
    },
    {
      "failureCode": "extension_date_invalid",
      "messageZh": "新计划离店日期必须晚于当前计划离店日期。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "extension_finance_requires_finance_gate",

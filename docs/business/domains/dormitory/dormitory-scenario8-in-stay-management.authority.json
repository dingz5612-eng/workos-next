      "sideEffectsAllowed": false
    },
    {
      "failureCode": "credential_after_checkout_forbidden",
      "messageZh": "退房后不得保持或恢复有效入住凭证。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "checkout_preparation_release_forbidden",
      "messageZh": "退房准备不能直接退房结算、退款或释放房源。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "forged_internal_reference",
      "messageZh": "系统引用不匹配，请从页面重新选择住客、入住记录、房间/床位或凭证。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "readonly_result_write_attempt",
      "messageZh": "查询、搜索、列表、看板、报表只读，不能在这里写入在住事实。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "duplicate_in_stay_submission",
      "messageZh": "该在住管理提交已处理，系统将返回原处理结果。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "concurrent_occupancy_conflict",
      "messageZh": "房间/床位占用状态已变化，请刷新后重试。",

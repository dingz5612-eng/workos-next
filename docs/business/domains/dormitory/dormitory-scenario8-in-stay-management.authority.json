      "sideEffectsAllowed": false
    },
    {
      "failureCode": "unauthorized_in_stay_action",
      "messageZh": "当前角色不能执行该在住管理动作。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "cross_scenario_checkout_refund_ledger_forbidden",
      "messageZh": "在住管理不能直接收款、退款、退房结算、释放房源或写账。",
      "sideEffectsAllowed": false
    }

      "failureCode": "discount_approval_required",
      "messageZh": "优惠超出权限，需要审批通过后才能生成报价。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "price_snapshot_mismatch",
      "messageZh": "报价价格快照与价格来源不一致，请重新生成报价。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "quote_expired_for_reservation_preparation",
      "messageZh": "报价已过期，不能发起转预订准备，请重新报价。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "post_issue_inline_edit_forbidden",
      "messageZh": "已发送报价不能原地编辑，请新建报价版本或重新报价。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "forged_internal_reference",
      "messageZh": "系统引用不匹配，请从页面重新选择客户、商品或报价。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "duplicate_submission",
      "messageZh": "该提交已处理，系统将返回原处理结果。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "concurrent_quote_version_conflict",
      "messageZh": "报价版本已被他人更新，请刷新后重试。",
      "sideEffectsAllowed": false
    },
    {
      "failureCode": "readonly_result_write_attempt",
      "messageZh": "查询、搜索、列表、看板、报表只读，不能在这里写入询价或报价事实。",
      "sideEffectsAllowed": false

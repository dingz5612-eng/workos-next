{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workos-next.local/schemas/b-stage-gate-result.schema.json",
  "type": "object",
  "required": ["b_stage_gate_result_id", "status", "source_mode", "no_go_items", "go_items", "inputs"],
  "additionalProperties": true,
  "properties": {
    "b_stage_gate_result_id": { "type": "string" },
    "status": { "type": "string", "enum": ["passed", "blocked"] },
    "source_mode": { "type": "string", "enum": ["real"] },
    "no_go_items": { "type": "array", "items": { "type": "string" } },
    "go_items": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "object" }
  }
}

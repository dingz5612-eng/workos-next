{
  "version": "oam.workflow-state-registry.v1",
  "status": "authoritative",
  "architecture": "oam.current",
  "definitionRegistry": "docs/contracts/definition/workitem-definition-registry.json",
  "admissionMatrix": "docs/contracts/admission/admission-matrix.json",
  "workflows": [
    {
      "workflowId": "workflow.roomSetup.v1",
      "sourceCardId": "roomSetup",
      "initialState": "draft",
      "allowedStates": ["draft", "ready", "admission_checked", "confirmed", "projecting", "completed", "correction_requested"],
      "forbiddenStates": ["production_confirmed", "direct_db_written"],
      "actions": [
        {
          "actionId": "roomSetup.confirm",
          "from": ["ready"],
          "to": "confirmed",
          "preconditions": ["definition_resolved", "required_fields_present", "idempotency_key_present"],
          "admissionMatrixEntry": "dormitory_l1_internal_pilot_observation",
          "evidenceRequired": ["room_readiness_if_blocked"],
          "visibleRoles": ["operator", "manager"],
          "mobileVisible": true,
          "pcGovernanceAction": false,
          "revokePath": "append_only_correction_work_item",
          "correctionPath": "room_readiness_or_room_release"
        }
      ]
    },
    {
      "workflowId": "workflow.bedSetup.v1",
      "sourceCardId": "bedSetup",
      "initialState": "draft",
      "allowedStates": ["draft", "ready", "admission_checked", "confirmed", "projecting", "completed", "correction_requested"],
      "forbiddenStates": ["production_confirmed", "direct_db_written"],
      "actions": [
        {
          "actionId": "bedSetup.confirm",
          "from": ["ready"],
          "to": "confirmed",
          "preconditions": ["definition_resolved", "room_exists", "bed_count_valid"],
          "admissionMatrixEntry": "dormitory_l1_internal_pilot_observation",
          "evidenceRequired": [],
          "visibleRoles": ["operator", "manager"],
          "mobileVisible": true,
          "pcGovernanceAction": false,
          "revokePath": "append_only_correction_work_item",
          "correctionPath": "room_readiness_or_room_release"
        }
      ]
    },
    {
      "workflowId": "workflow.paymentReceipt.v1",
      "sourceCardId": "paymentReceipt",
      "initialState": "draft",
      "allowedStates": ["draft", "ready", "admission_checked", "confirmed", "projecting", "completed", "correction_requested"],
      "forbiddenStates": ["deposit_mixed_as_payment", "direct_ledger_write"],
      "actions": [
        {
          "actionId": "paymentReceipt.confirm",
          "from": ["ready"],
          "to": "confirmed",
          "preconditions": ["definition_resolved", "payment_amount_valid", "non_cash_evidence_if_needed"],
          "admissionMatrixEntry": "dormitory_l1_internal_pilot_observation",
          "evidenceRequired": ["payment_evidence_for_non_cash"],
          "visibleRoles": ["finance", "manager"],
          "mobileVisible": true,
          "pcGovernanceAction": false,
          "revokePath": "ledger_correction_request",
          "correctionPath": "ledgerCorrectionApply"
        }
      ]
    },
    {
      "workflowId": "workflow.paymentConfirmation.v1",
      "sourceCardId": "paymentConfirmation",
      "initialState": "ready",
      "allowedStates": ["ready", "admission_checked", "trusted_device_checked", "confirmed", "projecting", "completed", "blocked"],
      "forbiddenStates": ["production_confirmed", "untrusted_device_confirmed", "direct_ledger_write"],
      "actions": [
        {
          "actionId": "paymentConfirmation.confirm",
          "from": ["ready"],
          "to": "confirmed",
          "preconditions": ["finance_capability", "trusted_device", "reason_present", "evidence_refs_present", "admission_decision_ref_present"],
          "admissionMatrixEntry": "payment_confirmation",
          "evidenceRequired": ["payment_evidence", "admission_decision_ref"],
          "visibleRoles": ["finance", "manager"],
          "mobileVisible": true,
          "pcGovernanceAction": false,
          "revokePath": "ledger_correction_request",
          "correctionPath": "ledgerCorrectionApply"
        }
      ]
    },
    {
      "workflowId": "workflow.depositRefund.v1",
      "sourceCardId": "depositRefundPayment",
      "initialState": "ready",
      "allowedStates": ["ready", "approval_checked", "trusted_device_checked", "confirmed", "projecting", "completed", "blocked"],
      "forbiddenStates": ["refund_without_balance", "refund_as_expense", "untrusted_device_confirmed"],
      "actions": [
        {
          "actionId": "depositRefundPayment.confirm",
          "from": ["approval_checked"],
          "to": "confirmed",
          "preconditions": ["finance_capability", "trusted_device", "refund_balance_valid", "reason_present", "evidence_refs_present"],
          "admissionMatrixEntry": "deposit_refund",
          "evidenceRequired": ["approval_evidence", "payment_evidence", "admission_decision_ref"],
          "visibleRoles": ["finance", "manager"],
          "mobileVisible": true,
          "pcGovernanceAction": true,
          "revokePath": "ledger_correction_request",
          "correctionPath": "ledgerCorrectionApply"
        }
      ]
    },
    {
      "workflowId": "workflow.serviceTask.v1",
      "sourceCardId": "roomReadiness",
      "initialState": "draft",
      "allowedStates": ["draft", "assigned", "in_progress", "completed", "verified", "rework_requested", "availability_release_requested"],
      "forbiddenStates": ["object_reselected_after_create", "availability_released_without_verification"],
      "actions": [
        {
          "actionId": "serviceTask.verify",
          "from": ["completed"],
          "to": "verified",
          "preconditions": ["task_object_fixed", "evidence_refs_present", "manager_or_housekeeping_role"],
          "admissionMatrixEntry": "dormitory_l1_internal_pilot_observation",
          "evidenceRequired": ["completion_photo_or_note"],
          "visibleRoles": ["housekeeping", "manager"],
          "mobileVisible": true,
          "pcGovernanceAction": false,
          "revokePath": "rework_work_item",
          "correctionPath": "roomReadiness"
        }
      ]
    },
    {
      "workflowId": "workflow.periodClose.v1",
      "sourceCardId": "periodClose",
      "initialState": "ready",
      "allowedStates": ["ready", "scope_checked", "finance_checked", "operations_checked", "business_signed", "closed", "blocked"],
      "forbiddenStates": ["closed_without_snapshot", "production_closed"],
      "actions": [
        {
          "actionId": "periodClose.confirm",
          "from": ["business_signed"],
          "to": "closed",
          "preconditions": ["period_scope_present", "finance_snapshot_present", "trusted_device", "reason_present", "evidence_refs_present", "business_signoff_present"],
          "admissionMatrixEntry": "period_close",
          "evidenceRequired": ["frozen_snapshot", "business_signoff", "admission_decision_ref"],
          "visibleRoles": ["manager", "releaseowner"],
          "mobileVisible": false,
          "pcGovernanceAction": true,
          "revokePath": "append_only_period_correction",
          "correctionPath": "ledgerCorrectionApply"
        }
      ]
    },
    {
      "workflowId": "workflow.ledgerCorrectionApply.v1",
      "sourceCardId": "ledgerCorrectionApply",
      "initialState": "requested",
      "allowedStates": ["requested", "reviewed", "approved", "trusted_device_checked", "applied", "rejected", "audited"],
      "forbiddenStates": ["old_entry_updated", "old_entry_deleted", "applied_without_approval"],
      "actions": [
        {
          "actionId": "ledgerCorrectionApply.confirm",
          "from": ["approved"],
          "to": "applied",
          "preconditions": ["finance_correction_capability", "trusted_device", "reason_present", "evidence_refs_present", "before_after_snapshot", "approval_chain_present", "admission_decision_ref_present"],
          "admissionMatrixEntry": "payment_confirmation",
          "evidenceRequired": ["before_snapshot", "after_snapshot", "approval_chain", "admission_decision_ref"],
          "visibleRoles": ["finance", "releaseowner"],
          "mobileVisible": false,
          "pcGovernanceAction": true,
          "revokePath": "new_compensation_correction",
          "correctionPath": "append_only_ledger_reversal"
        }
      ]
    }
  ],
  "invariants": [
    "Every workflow sourceCardId must exist in WorkItem Definition Registry.",
    "Every action must reference an Admission Matrix entry.",
    "High-risk finance and correction actions must require trusted device, reason, evidence, and admission decision ref.",
    "Correction paths are append-only and never update old facts in place."
  ]
}

{
  "version": "workosnext.authority.master-design.v1",
  "status": "authoritative-current-no-go",
  "architecture": "oam.current",
  "designId": "current-oam-p0b-p0c-master-design",
  "authorityRefs": [
    "docs/oam/current-architecture.md",
    "docs/contracts/oam.current.json",
    "docs/contracts/admission/admission-contract.json",
    "docs/contracts/definition/workitem-definition-registry.json",
    "docs/business/truth-owner-registry.yml"
  ],
  "currentArchitectureUniqueEffective": {
    "architecture": "oam.current",
    "uniqueEffective": true,
    "secondAuthorityAllowed": false,
    "currentArchitectureRef": "docs/oam/current-architecture.md"
  },
  "fourGraphViewPolicy": [
    {
      "graphId": "authorityGraph",
      "role": "viewOnly",
      "notArtifactClass": true
    },
    {
      "graphId": "kernelCompileGraph",
      "role": "viewOnly",
      "notArtifactClass": true
    },
    {
      "graphId": "runtimeEffectGraph",
      "role": "viewOnly",
      "notArtifactClass": true
    },
    {
      "graphId": "readEvidenceGraph",
      "role": "viewOnly",
      "notArtifactClass": true
    }
  ],
  "threeLayerPartitionPolicy": [
    {
      "layerId": "Source Layer",
      "partitionRole": "authoritativeInput",
      "executionOrderRole": false,
      "allowedAuthorityWrite": true,
      "forbiddenOverreach": ["derived contract", "runtime code", "CI evidence reinterpret business fact"]
    },
    {
      "layerId": "Generated Layer",
      "partitionRole": "compiledOutput",
      "executionOrderRole": false,
      "allowedAuthorityWrite": false,
      "forbiddenOverreach": ["manual edit", "declare business fact authority", "bypass Source Layer"]
    },
    {
      "layerId": "Runtime / Evidence Layer",
      "partitionRole": "runtimeAndProof",
      "executionOrderRole": false,
      "allowedAuthorityWrite": false,
      "forbiddenOverreach": ["redefine Source rule", "interpret CI green as GO", "interpret artifact existence as GO"]
    }
  ],
  "sixLoopExecutionOrder": [
    "Authority Closure",
    "Source Kernel Closure",
    "Compiler Closure",
    "Runtime WorkItem Effect Closure",
    "Read / Surface Consumption Closure",
    "Release Evidence Closure"
  ],
  "notGoSignals": [
    "ci.green",
    "artifact.exists",
    "browser.evidence",
    "finalReport.exists"
  ],
  "secondAuthorityForbiddenSources": [
    "closed catalog",
    "closed seed",
    "generated view",
    "dashboard",
    "search",
    "surface"
  ],
  "canonicalConfirmOrder": [
    "catalog.GetWorkItem",
    "definitions.Resolve(workItem)",
    "unresolved 422 reject",
    "VerifiedDeviceTrustContext.FromServerSession",
    "admission.EvaluateConfirm",
    "OperationsCommandRequest",
    "unitOfWork.Commit",
    "RecordWorkItemTransition",
    "DispatchNextOperationWorkItem"
  ],
  "blockedMutationClasses": [
    "UnitOfWork",
    "CommandSubmission",
    "DomainEvent",
    "WorkItemEvent",
    "LedgerTransaction",
    "LedgerEntry",
    "Outbox",
    "confirmed transition",
    "next work item",
    "projection",
    "lens",
    "search",
    "WriteLog"
  ],
  "compatibilityFences": [
    "ResolveByWorkspaceCard is read-only compatibility and migration only.",
    "FindBySourceCardId is read-only compatibility and migration only.",
    "cardId is UI route identity only and never command identity."
  ],
  "releaseLocks": {
    "businessProduction": "BLOCKED",
    "dormitoryL2": "BLOCKED",
    "productionConfirmAllowed": false,
    "finalGoNoGo": "NO_GO",
    "nextStageAllowed": false
  }
}

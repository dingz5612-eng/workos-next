      "permissionEnvelope": {
        "policyRef": "metric-permission.operations-readonly.v1",
        "readOnly": true
      },
      "lineageEnvelope": {
        "policyRef": "metric-lineage.generated-read-model.v1",
        "sourceFacts": ["Room", "Bed", "WorkItemFact"]
      },
      "freshnessEnvelope": {
        "policyRef": "metric-freshness.daily-read-model.v1",

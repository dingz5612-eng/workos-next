      },
      "lineageEnvelope": {
        "policyRef": "metric-lineage.finance-kernel.v1",
        "sourceFacts": ["FinancialFact", "LedgerTransaction", "LedgerEntry"]
      },
      "freshnessEnvelope": {
        "policyRef": "metric-freshness.ledger-read-model.v1",
        "maxStalenessMs": 3600000
      },
      "exportPolicy": "readonly-finance-evidence",
      "noBusinessFactWrite": true
    }
  ],
  "forbiddenInference": ["ui.state", "label", "displayText", "dashboard.summary"],

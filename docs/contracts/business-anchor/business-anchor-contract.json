{
  "version": "oam.business-anchor-contract.v1",
  "kernel": "Business Anchor Kernel",
  "rule": "业务锚点是由真值对象投影、运行事件、WorkItem 上下文和会话安全载荷组成的展示与搜索标签。它们不得成为权威业务事实或写入输入。",
  "truthBoundary": {
    "authoritativeObjects": [
      "roomId",
      "bedId",
      "stayId",
      "residentId",
      "depositId",
      "paymentId",
      "taskId",
      "checkoutId",
      "periodId"
    ],
    "displaySearchOnlyFields": [
      "residentName",
      "customerName",
      "contactName",
      "guestName",
      "leadName",
      "residentPhone",
      "customerPhone",
      "contactPhone",
      "phone",
      "mobile"
    ],
    "forbiddenUses": [
      "把姓名或电话当作事实归属",
      "把锚点文本当作命令真值提交",
      "让前端生成锚点替代后端对象 ID",
      "已有展示锚点时仍向普通用户展示运行时原始 ID"
    ]
  },
  "anchorPattern": {
    "surface": "business-anchor",
    "visiblePattern": "房间标签 · 床位标签 · 人员展示名 · 脱敏电话 · 当前动作",
    "example": "D02 / 22 · 01 上铺 · 张三 · 138****1234 · 押金待确认",
    "searchPattern": "房间标签、床位标签、人员展示名、脱敏电话、原始电话搜索令牌、当前动作",
    "privacy": "可见电话必须脱敏。原始电话只能在 Search Kernel 权限内作为本地搜索令牌或后端搜索键使用。"
  },

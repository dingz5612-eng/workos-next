  "surfaceRequirements": [
    "工作台任务卡在有锚点令牌时必须显示一行业务锚点。",
    "搜索结果卡必须包含同一锚点行，并按锚点令牌参与排序。",
    "学习中心场景卡必须使用同一锚点模式解释场景。",
    "办理步骤栏必须在当前工作区标题附近显示案件锚点。",
    "锚点渲染必须共用内核，不得逐页面复制。"
  ],
  "evidenceRequirements": [
    "学习中心锚点真实浏览器截图",

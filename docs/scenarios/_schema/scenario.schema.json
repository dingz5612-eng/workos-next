{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workos-next.local/schemas/executable-scenario.schema.json",
  "title": "Executable Scenario Pack",
  "type": "object",
  "required": ["version", "domain", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["scenarioId", "name", "scenarioType", "expectedOutcome", "workItemType", "outputs"],
      "additionalProperties": false,
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "scenarioType": {
          "type": "string",
          "enum": ["committed_scenario", "rejected_command_scenario", "gate_only_blocked_scenario"]
        },
        "expectedOutcome": { "type": "string", "minLength": 1 },
        "workItemType": { "type": "string", "minLength": 1 },
        "moneyCommand": { "type": "boolean" },
        "requiredEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "type": "object",
          "required": ["workItem"],
          "additionalProperties": true,
          "properties": {
            "workItem": { "$ref": "#/$defs/requiredRef" },
            "commandSubmission": { "$ref": "#/$defs/requiredRef" },
            "rejectedCommandSubmission": { "$ref": "#/$defs/requiredRef" },
            "rejectionTrace": { "$ref": "#/$defs/requiredRef" },
            "factTrace": { "$ref": "#/$defs/requiredRef" },
            "domainEvents": { "$ref": "#/$defs/refPolicy" },
            "ledgerTransactions": { "$ref": "#/$defs/refPolicy" },
            "ledgerEntries": { "$ref": "#/$defs/refPolicy" },
            "gateResult": { "$ref": "#/$defs/requiredRef" },
            "invariantChecks": { "$ref": "#/$defs/refPolicy" },
            "shadowCompareReports": { "$ref": "#/$defs/refPolicy" },
            "rollbackBlocker": { "$ref": "#/$defs/requiredRef" },
            "auditEvidence": { "$ref": "#/$defs/refPolicy" },
            "evidenceTrace": { "$ref": "#/$defs/requiredRef" },
            "lensOutputs": { "$ref": "#/$defs/refPolicy" },
            "operatingControlVisibility": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "noDuplicateSideEffect": { "$ref": "#/$defs/requiredRef" }
          }
        }
      }
    },
    "requiredRef": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "ref": { "type": "string" }
      }
    },
    "refPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean" },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

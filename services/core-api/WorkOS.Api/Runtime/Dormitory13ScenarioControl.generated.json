    "regressionGuards": {
      "scenario1": [
        "saveDraft/backToEdit/continueEdit 只能作为动作，不得生成字段。",
        "基础检查、保洁检查、设施检查、安全检查和基础就绪结论必须是 businessSelect。",
        "所属房间只能来自上游或系统带出，不得要求重复手填，不得渲染空白只读输入。",
        "Dorm.RoomSetupConfirm、Dorm.BedSetupConfirm、Dorm.ResourceReadinessConfirm 和内部 ID 不得显示给普通用户。",
        "材料名称中英俄不得回退为中文提交值或技术字段。"
      ],
      "scenario2": [
        "检查项不得让一线写长文本；保洁、维修、安全、设施检查结果必须是 businessSelect。",
        "预计恢复时间必须是 conditionalInput，只有暂不可运营、部分不可运营、暂停开放、维修中、保洁中、停售、异常待处理或待复查时才显示/必填。",
        "保存草稿、返回修改、继续填写不得作为业务字段提交。",
        "场景 1 输出只能 readOnlySummary 复用，不得重复填写房间号、床位号或基础就绪信息。"
      ],
      "allScenarios": [
        "场景 1-13 必须都有 fields.fieldAuthority 和 operation experience step contract。",
        "legalAction/actionControl 不得出现在 userFilledFields、userSelectedFields 或 runtime form fields。",
        "readOnlySummary 必须进入 generated runtime execution，并以只读上下文展示，不得成为用户输入。",
        "金额页面必须展示币种、业务对象、方向和阶段语义。",
        "搜索、阅读、列表、详情必须消费 searchReadModel 的业务语言。"
      ]
    }
  },

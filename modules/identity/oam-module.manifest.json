{
  "module": "identity",
  "productCapability": [
    "identity.account-actor",
    "governance.release-control"
  ],
  "domainInvariant": [
    "登录页只允许用户名和密码",
    "角色、部门、能力、租户、设备信任不得自助绑定",
    "Operations Confirm、Search、PC 页面、财务动作、发布动作必须从后端 session capabilities 判断",
    "账号变更必须产生 account audit"
  ],
  "api": [
    "POST /api/auth/login",
    "POST /api/auth/logout",
    "POST /api/auth/sessions/{token}/revoke",
    "POST /api/device-sessions",
    "POST /api/device-sessions/{deviceId}/revoke",
    "GET /api/pc-governance/account-users",
    "POST /api/pc-governance/account-users",
    "POST /api/pc-governance/account-users/{userId}/disable",
    "POST /api/pc-governance/account-users/{userId}/reset-password"
  ],
  "database": [
    "account_users",
    "runtime_sessions",
    "device_sessions",
    "account_audit_events"
  ],
  "tests": [
    "tests/WorkOS.UnitTests",
    "tests/WorkOS.RuntimeIntegrationTests"
  ],
  "rules": [
    "docs/contracts/oam.current.json",
    "docs/business/experience-contract.yml",
    "docs/surface/surface-contract.yml"
  ],
  "currentCodeOwners": [
    "services/core-api/WorkOS.Api/Runtime/RuntimeActorAuthentication.cs",
    "services/core-api/WorkOS.Api/Runtime/AccountActorKernelStorage.cs",
    "apps/mobile/src/accountGovernanceCatalog.js",
    "apps/mobile/src/views/loginView.js"
  ]
}
